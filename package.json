{
  "name": "infra-guardian",
  "version": "0.1.0",
  "private": true,
  "description": "Jev-guided circuit breaker, rate limiter, and batch preemption that degrades predictably under stress",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "netlify dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e.mjs",
    "deploy": "netlify deploy --prod",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.0",
    "@netlify/functions": "6.0.0",
    "@typesafe-ai/sdk": "0.6.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
